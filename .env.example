# ─── Copy to .env and fill in values ─────────────────────────────────────────
# Never commit .env to git.

# ── Kafka (Docker internal) ──────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Docker services use: kafka:9092

# ── Cassandra ────────────────────────────────────────────────────────────────
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=trafficx
# CASSANDRA_USERNAME=
# CASSANDRA_PASSWORD=
# Docker services use: cassandra

# ── Backend ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-32-char-string
API_HOST=0.0.0.0
API_PORT=8000
DEMO_MODE=true

# ── ML ────────────────────────────────────────────────────────────────────────
# Run python -m app.ml.lstm_train inside backend container to generate these.
LSTM_MODEL_PATH=./app/ml/models/lstm_model.keras
LSTM_SCALER_PATH=./app/ml/models/lstm_scaler.pkl
ML_MODEL_PATH=./app/ml/models/congestion_model.joblib

# ── External APIs (all optional — simulated when blank) ──────────────────────

# TomTom Traffic  →  https://developer.tomtom.com/  (Free tier available)
TOMTOM_API_KEY=

# HERE Traffic    →  https://developer.here.com/     (Free tier available)
HERE_API_KEY=

# OpenWeather     →  https://openweathermap.org/api  (Free tier available)
OPENWEATHER_API_KEY=

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
