# TrafficX Backend Environment Variables
# Copy to .env and fill in your values

# API
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Supabase PostgreSQL or local)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/trafficx
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-frontend.vercel.app

# ML Model
ML_MODEL_PATH=./app/ml/models/congestion_model.joblib
DEMO_MODE=true
